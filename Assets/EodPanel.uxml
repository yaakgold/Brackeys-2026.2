    <ui:VisualElement name="pnlEod" class="blocks-modal" style="flex-grow: 1; display: none;">
        <ui:Label text="End of Day 0" name="lblTitle" style="font-size: 59px; -unity-text-align: upper-center; color: rgb(159, 159, 159);"/>
        <ui:MultiColumnListView columns="" sort-column-descriptions="" name="mcListView" virtualization-method="DynamicHeight" class="blocks-list-view--no-hover" style="width: 100%;">
            <ui:Columns>
                <ui:Column width="40%" cell-template="project://database/Assets/PlayerData.uxml?fileID=9197481963319205126&amp;guid=9f1e324c0b10ff810945efebcaf20df3&amp;type=3#PlayerData" name="Player Name" title="Player Name"/>
                <ui:Column width="40%" cell-template="project://database/Assets/PlayerData.uxml?fileID=9197481963319205126&amp;guid=9f1e324c0b10ff810945efebcaf20df3&amp;type=3#PlayerData" name="Total Quality Added" title="Total Quality Added"/>
                <ui:Column width="20%" name="Vote To Kick Off Team" title="Vote To Kick Off Team"/>
            </ui:Columns>
        </ui:MultiColumnListView>
        <ui:Button text="Skip Vote" name="btnSkip" class="blocks-button" style="position: absolute; right: auto; bottom: auto; top: 50px; left: 50px;"/>
    </ui:VisualElement>
</ui:UXML>
