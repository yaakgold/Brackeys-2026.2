    <Style src="project://database/Assets/Scripts/Blocks/Common/Content/stylesheets/labels.uss?fileID=7433441132597879392&amp;guid=3967daf31cdfb2d4b8326839de2c378e&amp;type=3#labels"/>
    <Style src="project://database/Assets/Scripts/Blocks/Common/Content/stylesheets/utilities.uss?fileID=7433441132597879392&amp;guid=c4c8f1a4b06149cba4827009b662075d&amp;type=3#utilities"/>
    <Style src="project://database/Assets/Scripts/Blocks/Common/Content/stylesheets/inputs.uss?fileID=7433441132597879392&amp;guid=e01aade3b4d44466be1a74cda2e4b773&amp;type=3#inputs"/>
    <ui:VisualElement data-source="project://database/Assets/Settings/SessionSettings.asset?fileID=11400000&amp;guid=0bf4e1684added44da254017c7fc41b2&amp;type=2#SessionSettings" style="flex-grow: 1; align-items: center; align-self: center; justify-content: flex-start; align-content: center; flex-direction: column; flex-wrap: nowrap; max-width: 100%; width: 100%;">
        <ui:VisualElement name="" style="flex-grow: 1; height: auto; min-height: 0; max-height: 100%; width: 75%;">
            <ui:VisualElement name="mainMenu" class="blocks-menu blocks-modal" style="flex-grow: 1; visibility: visible; overflow: visible; opacity: 1; height: 80%; display: flex; margin-bottom: 2%;">
                <ui:Label text="The Problematic Vibe Coder" class="blocks-header blocks-header--space-bottom" style="-unity-text-auto-size: best-fit 10px 1000px;"/>
                <ui:Button text="Show Instructions" name="btnInstructions" class="blocks-button"/>
                <ui:TextField label="Name:" placeholder-text="Enter your name..." name="playerName" max-length="50" class="blocks-textfield" style="width: 50%; height: 25%; max-height: 25%; margin-top: 10%; margin-bottom: 5%;"/>
                <ui:Button text="Find a Lobby" name="btnJoin" class="blocks-button"/>
                <ui:VisualElement name="pnlInstructions" class="blocks-modal" style="flex-grow: 1; width: 100%; height: 100%; max-height: 100%; max-width: 100%; position: absolute; top: 0; background-color: rgb(69, 69, 69); display: none;">
                    <ui:Image source="project://database/Assets/Images/Instruction_0.png?fileID=2800000&amp;guid=eea0be1ba3ee93a0bb89373f67730c57&amp;type=3#Instruction_0" name="imgInstruction"/>
                    <ui:Button text="Next" name="btnNext" class="blocks-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Instance template="CurrentSession" name="currentSession" data-source="project://database/Assets/Settings/SessionSettings.asset?fileID=11400000&amp;guid=0bf4e1684added44da254017c7fc41b2&amp;type=2#SessionSettings" style="display: none; min-width: 85%; margin-top: 10px; width: 100%; height: 100%; max-height: 100%; max-width: 100%; margin-bottom: 10px; align-content: stretch;"/>
            <ui:VisualElement name="join" style="flex-grow: 1; flex-direction: row; justify-content: center; align-self: auto; align-content: auto; align-items: center; display: none;">
                <ui:Instance template="JoinSessionByQuickJoin" data-source="project://database/Assets/Settings/SessionSettings.asset?fileID=11400000&amp;guid=0bf4e1684added44da254017c7fc41b2&amp;type=2#SessionSettings" name="quickJoin" data-source-path="" style="align-items: center; align-content: center; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; width: 50%; max-width: 50%;"/>
                <ui:Instance template="JoinSessionByCode" name="byCode" data-source="project://database/Assets/Settings/SessionSettings.asset?fileID=11400000&amp;guid=0bf4e1684added44da254017c7fc41b2&amp;type=2#SessionSettings" style="margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; width: 50%; max-width: 50%;"/>
            </ui:VisualElement>
            <ui:VisualElement class="blocks-modal blocks-container--horizontal" style="flex-grow: 1; bottom: auto; position: relative; width: 100%; height: 15%; max-height: 15%; margin-bottom: 10px;">
                <ui:Button text="Back" name="btnBack" class="blocks-button" style="display: none;"/>
                <ui:Button text="Exit" name="btnExit" class="blocks-button"/>
                <ui:Button text="Start Game" name="btnStart" enabled="false" data-source="project://database/Assets/Settings/SessionSettings.asset?fileID=11400000&amp;guid=0bf4e1684added44da254017c7fc41b2&amp;type=2#SessionSettings" class="blocks-button" style="display: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
