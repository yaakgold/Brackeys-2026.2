<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/Blocks/Common/Content/stylesheets/modals.uss?fileID=7433441132597879392&amp;guid=cef182fc9fb448339fe32a55e8ba31b6&amp;type=3#modals"/>
    <Style src="project://database/Assets/Scripts/Blocks/Common/Content/stylesheets/labels.uss?fileID=7433441132597879392&amp;guid=3967daf31cdfb2d4b8326839de2c378e&amp;type=3#labels"/>
    <Style src="project://database/Assets/Scripts/Blocks/Common/Content/stylesheets/buttons.uss?fileID=7433441132597879392&amp;guid=24a81c4df0f34b7f8c53416ae3f8d529&amp;type=3#buttons"/>
    <ui:VisualElement name="pnlEndOfJam" class="blocks-modal" style="flex-grow: 1; background-color: rgb(16, 16, 16); display: none;">
        <ui:Label text="END OF JAM" class="blocks-header--space-bottom blocks-label" style="font-size: 70px;"/>
        <ui:Label text="You made a game of {} quality&#10;This is considered a {} game" name="lblTotalQualityAdded" class="blocks-label blocks-header--sm blocks-header--space-bottom" style="font-size: 50px; -unity-text-align: upper-center;"/>
        <ui:MultiColumnListView columns="" sort-column-descriptions="" name="mclvEndResults" virtualization-method="DynamicHeight" style="max-height: 100%; height: 100%; width: 100%;">
            <ui:Columns>
                <ui:Column width="33%" name="" title="Player Name"/>
                <ui:Column width="33%" title="Quality Added"/>
                <ui:Column width="33%" title="Role"/>
            </ui:Columns>
        </ui:MultiColumnListView>
        <ui:Button text="Leave" name="btnLeave" class="blocks-button" style="position: absolute; top: auto; right: 10px; bottom: 10px;"/>
    </ui:VisualElement>
</ui:UXML>
